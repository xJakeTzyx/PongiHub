        desc.TextColor3 = theme.dim
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextYAlignment = Enum.TextYAlignment.Top
        desc.ZIndex = 62
        desc.Parent = dlg

        -- custom body rows (number inputs etc.) — they grow the dialog; the
        -- footer buttons stay pinned to the bottom. Scrolls if rows overflow.
        local body = Instance.new('ScrollingFrame')  -- classic SF: the newer
        -- UIScrollingFrame can't be created on some executors, so this uses
        -- the same class the tabs use; CanvasSize is set manually in Resize
        body.Size = UDim2.new(1, -28, 0, 0)
        body.Position = UDim2.fromOffset(14, 104)
        body.BackgroundTransparency = 1
        body.BorderSizePixel = 0
        body.ScrollBarThickness = 4
