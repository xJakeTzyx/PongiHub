        local toggleBtn = Instance.new('TextButton')
        toggleBtn.Size = UDim2.new(1, 0, 0, 30)
        toggleBtn.BackgroundTransparency = 1
        toggleBtn.BorderSizePixel = 0
        toggleBtn.Text = ''
        toggleBtn.Parent = item._frame
        toggleBtn.Activated:Connect(function()
            value = not value
            apply()
            if info.Callback then
                -- a Callback may return `false` to refuse the flip (e.g. a
                -- confirmation popup is pending); the toggle reverts itself
                local keep = info.Callback(value)
                if keep == false then
