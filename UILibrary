    -- random ScreenGui name so it does not stand out in the executor explorer
    local function randName(len)
        local chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'
        local out = {}
        for _ = 1, (len or 12) do
            local i = math.random(1, #chars)
            out[#out + 1] = chars:sub(i, i)
        end
        return table.concat(out)
    end

    -- yield budget: the menu build creates hundreds of instances in one
    -- synchronous block, which freezes the whole client for seconds (the
    -- loading screen cannot animate). Yielding every N creations lets the
    -- renderer breathe — the build is a bit slower but the loading UI stays
    -- alive the whole time.
    local _yieldBudget = 0
    local function _maybeYield()
        _yieldBudget = _yieldBudget + 1
        if _yieldBudget % 20 == 0 then task.wait() end
    end

    -- hidden UI container (gethui & friends) — renders on screen but stays
    -- invisible in the executor explorer; falls back to CoreGui elsewhere
    local function hiddenUI()
        for _, fnName in ipairs({ 'gethui', 'get_hidden_gui', 'get_hidden_ui', 'gethiddengui', 'gethiddenui' }) do
            local fn = (getgenv and getgenv()[fnName]) or _G[fnName]
            if type(fn) == 'function' then
                local ok, h = pcall(fn)
                if ok and h then return h end
            end
        end
        return nil
    end

    -- remove leftover PongiUI windows from previous runs
    local function cleanStale()
        local roots = { CoreGui:FindFirstChild('RobloxGui'), hiddenUI() }
        for _, root in ipairs(roots) do
            if root then
                for _, sg in ipairs(root:GetChildren()) do
                    if sg:IsA('ScreenGui') and sg:GetAttribute('PongihubUI') then
                        pcall(function() sg:Destroy() end)
                    end
                end
            end
        end
    end

