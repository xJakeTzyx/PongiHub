        display.TextColor3 = Color3.new(1, 1, 1)
        display.TextXAlignment = Enum.TextXAlignment.Left
        display.TextTruncate = Enum.TextTruncate.AtEnd
        corner(display, 7)
        stroke(display, theme.outline, 1)
        display.Parent = item._frame

        local chev = newFont(13)
        chev.Size = UDim2.fromOffset(26, 32)
        chev.Position = UDim2.new(1, -30, 0, 0)
        chev.Text = 'v'
        chev.TextColor3 = theme.dim
        chev.Parent = display

        local menu = Instance.new('Frame')
        menu.Size = UDim2.new(1, 0, 0, 0)
        menu.Position = UDim2.fromOffset(0, 58)  -- 6px gap under the display
        menu.BackgroundColor3 = theme.bg
        menu.BorderSizePixel = 0
        menu.Visible = false
        corner(menu, 7)
        stroke(menu, theme.outline, 1)
        menu.Parent = item._frame
        local menuList = Instance.new('UIListLayout')
        menuList.Padding = UDim.new(0, 2)
        menuList.SortOrder = Enum.SortOrder.LayoutOrder
        menuList.Parent = menu
        local menuPad = Instance.new('UIPadding')
        menuPad.PaddingLeft = UDim.new(0, 2)
        menuPad.PaddingRight = UDim.new(0, 2)
        menuPad.PaddingTop = UDim.new(0, 2)
        menuPad.PaddingBottom = UDim.new(0, 2)
        menuPad.Parent = menu

        local values = {}
        for _, v in ipairs(info.Values or {}) do
            table.insert(values, v)
        end

        local dropdown = {
            _close = function() end,
        }

        local function close()
            if not menu.Visible then return end
            menu.Visible = false
            item._frame.Size = UDim2.new(1, 0, 0, 54)
            chev.Text = 'v'
            for i = #openDropdowns, 1, -1 do
                if openDropdowns[i] == dropdown then
                    table.remove(openDropdowns, i)
                end
            end
        end
        dropdown._close = close

        local function open()
            if menu.Visible then
                close()
                return
            end
            closeAllDropdowns(dropdown)
            for _, c in ipairs(menu:GetChildren()) do
                if c:IsA('TextButton') then c:Destroy() end
            end
            for _, v in ipairs(values) do
                local opt = Instance.new('TextButton')
                opt.Size = UDim2.new(1, 0, 0, 28)
                opt.Position = UDim2.fromOffset(0, 0)
                opt.BackgroundColor3 = theme.accent
                opt.BackgroundTransparency = 1
                opt.BorderSizePixel = 0
                corner(opt, 6)
                opt.Text = '   ' .. tostring(v)
                opt.Font = Enum.Font.Gotham
                opt.TextSize = 13
                opt.TextColor3 = v == current and theme.accent or theme.font
                opt.TextXAlignment = Enum.TextXAlignment.Left
                opt.Parent = menu
                opt.MouseEnter:Connect(function()
                    tween(opt, { BackgroundTransparency = 0 }, 0.12)
                    opt.TextColor3 = Color3.new(1, 1, 1)
                end)
                opt.MouseLeave:Connect(function()
                    tween(opt, { BackgroundTransparency = 1 }, 0.12)
                    opt.TextColor3 = v == current and theme.accent or theme.font
                end)
                opt.Activated:Connect(function()
                    current = v
                    display.Text = '  ' .. tostring(current)
                    close()
                    if info.Callback then
                        info.Callback(current)
                    end
                end)
            end
            menu.Size = UDim2.new(1, 0, 0, #values * 30 + 2)
            menu.Visible = true
            item._frame.Size = UDim2.new(1, 0, 0, 58 + #values * 30 + 6)
            chev.Text = '^'
            table.insert(openDropdowns, dropdown)
        end

        display.Activated:Connect(function()
            open()
        end)

        -- click outside the dropdown closes it (bounds = display + open menu)
        UserInputService.InputBegan:Connect(function(input)
            if menu.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
                task.wait()
                if not display:IsDescendantOf(ScreenGui) then return end
                local mouse = Players.LocalPlayer:GetMouse()
                local pos = Vector2.new(mouse.X, mouse.Y)
                local rel = display.AbsolutePosition
                local sz = display.AbsoluteSize
                local msz = menu.AbsoluteSize
                local top = rel.Y - 20
                local bottom = rel.Y + 32 + msz.Y + 4
                if pos.X < rel.X or pos.X > rel.X + sz.X or pos.Y < top or pos.Y > bottom then
                    close()
                end
            end
        end)

        item.SetValue = function(_, v)
            current = v
            display.Text = '  ' .. tostring(current)
        end
        item.SetValues = function(_, list)
            values = {}
            for _, v in ipairs(list) do
                table.insert(values, v)
            end
        end
        return item
    end

