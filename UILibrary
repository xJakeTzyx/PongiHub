        box.Size = UDim2.new(1, 0, 0, 32)
        box.Position = UDim2.fromOffset(0, 22)
        box.BackgroundColor3 = theme.main2
        box.BorderSizePixel = 0
        box.PlaceholderText = ''
        box.Font = Enum.Font.Gotham
        box.TextSize = 13
        box.TextColor3 = Color3.new(1, 1, 1)
        box.TextXAlignment = Enum.TextXAlignment.Left
        corner(box, 7)
        stroke(box, theme.outline, 1)
        box.Parent = item._frame
        -- 2px top/bottom margin like the buttons (label 2..18, box 22..54)
        item._frame.Size = UDim2.new(1, 0, 0, 56)
        -- fake placeholder: the hint is always visible in gray until the
        -- user actually types (Roblox hides real placeholders on focus).
        -- TextButton/TextBox have no Padding in this client, so a two-space
        -- margin is baked into the text (stripped before the callback).
        local hint = info.Placeholder or ''
        local margin = '  '
        local realText = ''
        local function refresh()
            if realText == '' then
                box.Text = margin .. hint
                box.TextColor3 = theme.dim
            else
                box.Text = margin .. realText
                box.TextColor3 = Color3.new(1, 1, 1)
            end
        end
        refresh()
        box.Focused:Connect(function()
            if realText == '' then
                box.Text = margin
                box.TextColor3 = theme.font
            end
        end)
        box.FocusLost:Connect(function(enter)
            local stripped = box.Text:gsub('^%s+', '')
            realText = stripped
            refresh()
            if info.Callback then
                info.Callback(stripped, enter)
            end
        end)
        item._box = box
        return item
    end

    function GroupboxMeta:AddDropdown(id, info)
        _maybeYield()
        local gb = self
        -- 2px top/bottom margin like the buttons (label 2..18, display 20..52)
        local item = baseItem(gb, 54)
        local lbl = newFont(12)
        lbl.Size = UDim2.new(1, 0, 0, 16)
        lbl.Position = UDim2.fromOffset(0, 2)
        lbl.Text = info.Text or 'Dropdown'
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = item._frame

        local current = info.Default or ''
        local display = Instance.new('TextButton')
        display.Size = UDim2.new(1, 0, 0, 32)
        display.Position = UDim2.fromOffset(0, 20)
        display.BackgroundColor3 = theme.bg
        display.BorderSizePixel = 0
        display.Text = '  ' .. current
        display.Font = Enum.Font.Gotham
        display.TextSize = 13
        display.TextColor3 = Color3.new(1, 1, 1)
        display.TextXAlignment = Enum.TextXAlignment.Left
        display.TextTruncate = Enum.TextTruncate.AtEnd
        corner(display, 7)
        stroke(display, theme.outline, 1)
        display.Parent = item._frame

        local chev = newFont(13)
        chev.Size = UDim2.fromOffset(26, 32)
        chev.Position = UDim2.new(1, -30, 0, 0)
        chev.Text = 'v'
        chev.TextColor3 = theme.dim
        chev.Parent = display

        local menu = Instance.new('Frame')
        menu.Size = UDim2.new(1, 0, 0, 0)
        menu.Position = UDim2.fromOffset(0, 58)  -- 6px gap under the display
        menu.BackgroundColor3 = theme.bg
        menu.BorderSizePixel = 0
        menu.Visible = false
        corner(menu, 7)
        stroke(menu, theme.outline, 1)
        menu.Parent = item._frame
        local menuList = Instance.new('UIListLayout')
        menuList.Padding = UDim.new(0, 2)
        menuList.SortOrder = Enum.SortOrder.LayoutOrder
        menuList.Parent = menu
        local menuPad = Instance.new('UIPadding')
        menuPad.PaddingLeft = UDim.new(0, 2)
        menuPad.PaddingRight = UDim.new(0, 2)
        menuPad.PaddingTop = UDim.new(0, 2)
        menuPad.PaddingBottom = UDim.new(0, 2)
        menuPad.Parent = menu

        local values = {}
        for _, v in ipairs(info.Values or {}) do
            table.insert(values, v)
        end

        local dropdown = {
            _close = function() end,
        }

        local function close()
            if not menu.Visible then return end
            menu.Visible = false
            item._frame.Size = UDim2.new(1, 0, 0, 54)
            chev.Text = 'v'
            for i = #openDropdowns, 1, -1 do
                if openDropdowns[i] == dropdown then
                    table.remove(openDropdowns, i)
                end
            end
        end
        dropdown._close = close

        local function open()
            if menu.Visible then
                close()
                return
            end
            closeAllDropdowns(dropdown)
            for _, c in ipairs(menu:GetChildren()) do
                if c:IsA('TextButton') then c:Destroy() end
            end
            for _, v in ipairs(values) do
                local opt = Instance.new('TextButton')
                opt.Size = UDim2.new(1, 0, 0, 28)
                opt.Position = UDim2.fromOffset(0, 0)
                opt.BackgroundColor3 = theme.accent
                opt.BackgroundTransparency = 1
                opt.BorderSizePixel = 0
                corner(opt, 6)
                opt.Text = '   ' .. tostring(v)
                opt.Font = Enum.Font.Gotham
                opt.TextSize = 13
                opt.TextColor3 = v == current and theme.accent or theme.font
                opt.TextXAlignment = Enum.TextXAlignment.Left
                opt.Parent = menu
                opt.MouseEnter:Connect(function()
                    tween(opt, { BackgroundTransparency = 0 }, 0.12)
                    opt.TextColor3 = Color3.new(1, 1, 1)
                end)
                opt.MouseLeave:Connect(function()
                    tween(opt, { BackgroundTransparency = 1 }, 0.12)
                    opt.TextColor3 = v == current and theme.accent or theme.font
                end)
                opt.Activated:Connect(function()
                    current = v
                    display.Text = '  ' .. tostring(current)
                    close()
                    if info.Callback then
                        info.Callback(current)
                    end
                end)
            end
            menu.Size = UDim2.new(1, 0, 0, #values * 30 + 2)
            menu.Visible = true
            item._frame.Size = UDim2.new(1, 0, 0, 58 + #values * 30 + 6)
            chev.Text = '^'
            table.insert(openDropdowns, dropdown)
        end

        display.Activated:Connect(function()
            open()
        end)

        -- click outside the dropdown closes it (bounds = display + open menu)
        UserInputService.InputBegan:Connect(function(input)
            if menu.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
                task.wait()
                if not display:IsDescendantOf(ScreenGui) then return end
                local mouse = Players.LocalPlayer:GetMouse()
                local pos = Vector2.new(mouse.X, mouse.Y)
                local rel = display.AbsolutePosition
                local sz = display.AbsoluteSize
                local msz = menu.AbsoluteSize
                local top = rel.Y - 20
                local bottom = rel.Y + 32 + msz.Y + 4
                if pos.X < rel.X or pos.X > rel.X + sz.X or pos.Y < top or pos.Y > bottom then
                    close()
                end
            end
        end)

        item.SetValue = function(_, v)
            current = v
            display.Text = '  ' .. tostring(current)
        end
        item.SetValues = function(_, list)
            values = {}
            for _, v in ipairs(list) do
                table.insert(values, v)
            end
        end
        return item
    end

    -- ══════════════════════════════════════════════════════════════════
    -- KEY PICKER — records a key on click, fires Changed, and becomes the
    -- window toggle when the script sets PongiUI.ToggleKeybind to it.
    -- ══════════════════════════════════════════════════════════════════
    local KeyPickerMeta = {}
    KeyPickerMeta.__index = KeyPickerMeta
    function KeyPickerMeta:Update() end

    function KeyPickerMeta:Capture()
        if self._picker then
            self._picker.Activated:Fire()
        end
    end

    function KeyPickerMeta:DoClick()
        if self._picker then
            self._picker.Activated:Fire()
        end
    end

    local keyPicker = function(label, id, info)
        -- keys arrive as Enum.KeyCode, 'RightControl', or the full
        -- 'Enum.KeyCode.RightControl' path (what tostring produced in some
        -- environments) — normalize everything to the Enum so the toggle
        -- listener can compare input.KeyCode == kb._key
        local function coerceKey(k)
            if typeof(k) == 'EnumItem' then return k end
            if type(k) == 'string' then
                local short = k:match('Enum%.KeyCode%.(.+)$') or k
                return Enum.KeyCode[short]
            end
            return nil
        end
        local picker = Instance.new('TextButton')
        picker.Size = UDim2.fromOffset(110, 26)
        picker.Position = UDim2.new(1, -118, 0, 3)
        picker.BackgroundColor3 = theme.main2
        picker.BorderSizePixel = 0
        picker.TextTruncate = Enum.TextTruncate.AtEnd
        picker.Font = Enum.Font.Gotham
        picker.TextSize = 12
        picker.TextColor3 = theme.font
        corner(picker, 6)
        stroke(picker, theme.outline, 1)
        picker.Parent = label._frame

        local listening = false
        local captured = coerceKey(info.Default) or Enum.KeyCode.RightControl
        picker.Text = '[' .. captured.Name .. ']'
        local self = setmetatable({
            _picker = picker,
            _key = captured,
            _frame = label._frame,
            DisplayValue = captured,
        }, KeyPickerMeta)
        function self:SetValue(v, noEvent)
            local k = coerceKey(v)
            if k then
                captured = k
                self._key = k
                picker.Text = '[' .. k.Name .. ']'
            end
            if not noEvent and info.Changed then
                info.Changed(k and k.Name or v, {})
            end
        end
        local function beginCapture()
            listening = true
            captureCount = captureCount + 1
            picker.Text = '...'
            tween(picker, { BackgroundColor3 = theme.accent }, 0.15)
        end
        local function endCapture()
            listening = false
            if captureCount > 0 then captureCount = captureCount - 1 end
            tween(picker, { BackgroundColor3 = theme.main2 }, 0.15)
        end
        picker.Activated:Connect(function()
            beginCapture()
        end)
        UserInputService.InputBegan:Connect(function(input)
            if not listening then return end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                captured = input.KeyCode
                self._key = input.KeyCode
                picker.Text = '[' .. input.KeyCode.Name .. ']'
                endCapture()
                if info.Changed then
                    -- pass the clean name (not tostring(Enum)) so the saved
                    -- key file stores 'LeftControl', which restores next run
                    info.Changed(input.KeyCode.Name, {})
                end
            end
        end)

        Options[id] = self
        return self
    end

    function GroupboxMeta:AddLabel(text)
        _maybeYield()
        local item = baseItem(self, 32)
        local lbl = newFont(13)
        lbl.Size = UDim2.new(1, 0, 0, 28)
        lbl.Position = UDim2.fromOffset(0, 2)
        lbl.Text = text or ''
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = item._frame
        item._lbl = lbl
        item.SetText = function(_, t)
            lbl.Text = tostring(t)
        end
        item.AddKeyPicker = function(_, id, info)
            return keyPicker(item, id, info)
        end
        return item
    end

