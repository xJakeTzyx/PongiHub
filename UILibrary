    local function makeIcon(icon, size)
        local holder = Instance.new('Frame')
        holder.Size = UDim2.fromOffset(size or 22, size or 22)
        holder.BackgroundColor3 = theme.main2
        holder.BorderSizePixel = 0
        corner(holder, 6)
        stroke(holder, theme.outline, 1)
        local name = tostring(icon)
        local assetId = nil
        if tonumber(name) then
            assetId = name
        else
            local mapped = ICONS[name]
            if mapped and tonumber(mapped) then assetId = mapped end
        end
        if assetId then
            local img = Instance.new('ImageLabel')
            img.Size = UDim2.new(1, -6, 1, -6)
            img.Position = UDim2.fromOffset(3, 3)
            img.BackgroundTransparency = 1
            img.BorderSizePixel = 0
            img.Image = 'rbxassetid://' .. assetId
            img.Parent = holder
            return holder
        end
        local lbl = newFont(12)
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.TextColor3 = theme.accent
        lbl.Text = ICONS[name] or string.sub(name, 1, 1):upper()
        lbl.Parent = holder
        return holder
    end

    local function measure(text, size)
        local w = TPS:GetTextSize(text, size or 14, Enum.Font.Gotham, Vector2.new(2000, 50))
        return w.X
    end

    local WindowMeta = {}
    WindowMeta.__index = WindowMeta
    local GroupboxFactory = nil

    function PongiUI:CreateWindow(info)
        info = info or {}
        -- mobile: start at ~3/4 width (1.5x wider than the half-size) — the
        -- user can still drag it bigger/smaller with the same resize handle.
        -- Desktop keeps the full size.
        local mobile = UserInputService.TouchEnabled
        local INIT_W, INIT_H = mobile and 465 or 620, mobile and 286 or 572
        local MIN_W, MIN_H = mobile and 330 or 440, mobile and 180 or 360
        local root = Instance.new('Frame')
        root.Name = 'Main'
        root.Size = UDim2.fromOffset(INIT_W, INIT_H)
        root.AnchorPoint = Vector2.new(0.5, 0.5)
        root.Position = UDim2.fromScale(0.5, 0.42)
        root.BackgroundColor3 = theme.bg
        root.BorderSizePixel = 0
        corner(root, 10)
        stroke(root, theme.outline, 1)
        root.Parent = ScreenGui
        if LoadingActive then root.Visible = false end

        -- compact top bar: the smallest height that still fits the icon
        -- (36px icon + 4px margins), title centered, no footer
        local top = Instance.new('Frame')
        top.Size = UDim2.new(1, 0, 0, 44)
        top.BackgroundColor3 = theme.main
        top.BorderSizePixel = 0
        corner(top, 10)
        top.Parent = root

        local logo = makeIcon(info.Icon or 'user', 36)
        logo.Position = UDim2.fromOffset(14, 4)
        logo.Parent = top
        -- title bar: main name centered, tier badge right after it — the
        -- badge is SMALLER and the same grey for BOTH tiers (uniform; the
        -- text itself tells the tier), and the pair stays centered together
        local rawTitle = info.Title or 'PongiUI'
        local mainPart = rawTitle:gsub('%s*%[%w+%]%s*$', '')
        local badgePart = rawTitle:match('%[%w+%]$') or ''
        local titleBar = Instance.new('Frame')
        titleBar.Size = UDim2.new(0, 0, 0, 44)
        titleBar.AnchorPoint = Vector2.new(0.5, 0)
        titleBar.Position = UDim2.fromScale(0.5, 0)
        titleBar.AutomaticSize = Enum.AutomaticSize.X
        titleBar.BackgroundTransparency = 1
        titleBar.Parent = top
        local titleList = Instance.new('UIListLayout')
        titleList.FillDirection = Enum.FillDirection.Horizontal
        titleList.HorizontalAlignment = Enum.HorizontalAlignment.Center
        titleList.VerticalAlignment = Enum.VerticalAlignment.Center
        titleList.Padding = UDim.new(0, 6)
        titleList.SortOrder = Enum.SortOrder.LayoutOrder
        titleList.Parent = titleBar
        local title = newFont(20)
        title.Size = UDim2.fromOffset(measure(mainPart, 20), 44)
        title.Text = mainPart
        title.TextYAlignment = Enum.TextYAlignment.Center
        title.Parent = titleBar
        if badgePart ~= '' then
            local badge = newFont(13)
            badge.Size = UDim2.fromOffset(measure(badgePart, 13), 44)
            badge.Text = badgePart
            badge.TextYAlignment = Enum.TextYAlignment.Center
            badge.TextColor3 = Color3.fromRGB(157, 151, 184)
            badge.Parent = titleBar
        end

        local tabRow = Instance.new('Frame')
        tabRow.Size = UDim2.new(1, -20, 0, 36)
        tabRow.Position = UDim2.fromOffset(10, 52)
        tabRow.BackgroundTransparency = 1
        tabRow.Parent = root
        local tabList = Instance.new('UIListLayout')
        tabList.FillDirection = Enum.FillDirection.Horizontal
        tabList.Padding = UDim.new(0, 6)
        tabList.SortOrder = Enum.SortOrder.LayoutOrder
        tabList.Parent = tabRow

        -- divider between the tabs and the sections, aligned with both
        local tabLine = Instance.new('Frame')
        tabLine.Size = UDim2.new(1, -20, 0, 1)
        tabLine.Position = UDim2.fromOffset(10, 92)
        tabLine.BackgroundColor3 = theme.outline
        tabLine.BorderSizePixel = 0
        tabLine.Parent = root

        -- body shares the tab row's margins so the sections align with the
        -- tabs (the scroll frames add only a thin padding for the outlines)
        local body = Instance.new('Frame')
        body.Size = UDim2.new(1, -20, 1, -108)
        body.Position = UDim2.fromOffset(10, 96)
        body.BackgroundTransparency = 1
        body.Parent = root

        local left = Instance.new('Frame')
        left.Size = UDim2.new(0.5, -7, 1, 0)
        left.BackgroundTransparency = 1
        left.Parent = body
        local right = Instance.new('Frame')
        right.Size = UDim2.new(0.5, -7, 1, 0)
        right.Position = UDim2.new(0.5, 7, 0, 0)
        right.BackgroundTransparency = 1
        right.Parent = body

        -- drag (input.Position is a Vector3 — never subtract it from a Vector2)
        local dragging = false
        local dragOffset = Vector2.new(0, 0)
        top.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local p = input.Position
                -- the window is anchored at its center — track the anchor so
                -- the click point stays under the cursor while dragging
                local anchor = root.AbsolutePosition + root.AbsoluteSize * root.AnchorPoint
                dragOffset = Vector2.new(p.X, p.Y) - anchor
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            -- on mobile Roblox fires BOTH MouseMovement AND Touch for one
            -- finger move — handling both makes the window jitter. Use
            -- Touch only when TouchEnabled, MouseMovement only on desktop.
            if dragging and (
                (UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.Touch)
                or (not UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.MouseMovement)
            ) then
                local p = input.Position
                root.Position = UDim2.fromOffset(p.X - dragOffset.X, p.Y - dragOffset.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- resize grip: hold the bottom-right corner dots and drag to resize
        -- (mouse AND touch — this is the mobile resize handle)
        local grip = Instance.new('Frame')
        grip.Size = UDim2.fromOffset(18, 18)
        grip.Position = UDim2.new(1, -24, 1, -24)
        grip.BackgroundTransparency = 1
        grip.ZIndex = 5
        grip.Parent = root
        for i = 0, 2 do
            local d = Instance.new('Frame')
            d.Size = UDim2.fromOffset(4, 4)
            d.Position = UDim2.fromOffset(14 - i * 6, 14 - i * 6)
            d.BackgroundColor3 = theme.dim
            d.BorderSizePixel = 0
            d.Parent = grip
        end
        local resizing = false
        grip.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            -- same as drag: one input type per device, never both
            if resizing and (
                (UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.Touch)
                or (not UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.MouseMovement)
            ) then
                local p = input.Position
                local newW = math.max(MIN_W, p.X - root.AbsolutePosition.X)
                local newH = math.max(MIN_H, p.Y - root.AbsolutePosition.Y)
                root.Size = UDim2.fromOffset(newW, newH)
                -- keep the pop animation's base size in sync with the resize
                Window._size = root.Size
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)

        -- mobile-only floating toggle button: sits at the top-left edge of
        -- the screen (off the window) so the UI opens/closes without a
        -- keyboard. Desktop never sees it (TouchEnabled is false there).
        if UserInputService.TouchEnabled then
            local toggleBtn = Instance.new('TextButton')
            toggleBtn.Size = UDim2.fromOffset(44, 44)
            toggleBtn.Position = UDim2.fromOffset(10, 14)
            toggleBtn.BackgroundColor3 = theme.main
            toggleBtn.BorderSizePixel = 0
            corner(toggleBtn, 12)
            stroke(toggleBtn, theme.outline, 1)
            toggleBtn.ZIndex = 300
            toggleBtn.Parent = ScreenGui
            -- stay hidden while the loading screen is up: the button must appear
            -- TOGETHER with the window, not before it
            toggleBtn.Visible = not LoadingActive
            MobileToggleBtn = toggleBtn
            local tIcon = makeIcon(info.Icon or 'user', 26)
            tIcon.Position = UDim2.fromOffset(9, 9)
            tIcon.Parent = toggleBtn
            toggleBtn.Activated:Connect(function()
                if Window then Window:Toggle() end
            end)
        end

        Window = setmetatable({
            _root = root,
            _size = UDim2.fromOffset(INIT_W, INIT_H),
            _tabs = {},
            _tabRow = tabRow,
            _left = left,
            _right = right,
            Title = info.Title or 'PongiUI',
            Icon = info.Icon,
            Footer = info.Footer,
        }, WindowMeta)

        return Window
    end

    -- fade the whole window (every descendant) together so closing/open
    -- looks synced; each element's original transparency is remembered the
    -- first time it is faded and restored when the window reopens
    local baseTransp = {}
    local activeFade = nil     -- the heartbeat connection of the running fade
    local fadeGen = 0          -- bumped on every toggle; stale fades/hides bail
    local function fadeWindow(root, opening, dur)
        -- one shared fade driver: every element is moved from the same
        -- progress value so backgrounds, text and images can never drift
        -- apart (many separate tweens stagger text behind the box on some
        -- executors). Base values are remembered on first use so reopens
        -- restore the original look exactly. If a fade is already running
        -- (close→open quickly), it is cancelled first so two drivers never
        -- fight over the same properties.
        if activeFade then activeFade:Disconnect(); activeFade = nil end
        local bgs, texts, imgs, strokes, scrolls = {}, {}, {}, {}, {}
        local function collect(g)
            if g:IsA('Frame') or g:IsA('TextButton') or g:IsA('TextBox') or g:IsA('ImageLabel') then
                bgs[#bgs+1] = g
            end
            if g:IsA('TextLabel') or g:IsA('TextButton') or g:IsA('TextBox') then
                texts[#texts+1] = g
            end
            if g:IsA('ImageLabel') then
                imgs[#imgs+1] = g
            end
            if g:IsA('UIStroke') then
                strokes[#strokes+1] = g
            elseif g:IsA('ScrollingFrame') then
                scrolls[#scrolls+1] = g
            end
            for _, c in ipairs(g:GetChildren()) do collect(c) end
        end
        collect(root)
        -- snapshot where elements are RIGHT NOW (opening after a close starts
        -- fully faded; a fresh open starts at originals) and remember the true
        -- originals on first use
        local curB, curT, curI, curS, curSc = {}, {}, {}, {}, {}
        for i, g in ipairs(bgs) do curB[i] = g.BackgroundTransparency end
        for i, g in ipairs(texts) do curT[i] = g.TextTransparency end
        for i, g in ipairs(imgs) do curI[i] = g.ImageTransparency end
        for i, g in ipairs(strokes) do curS[i] = g.Transparency end
        for i, g in ipairs(scrolls) do curSc[i] = g.ScrollBarImageTransparency end
        local function propOf(g, prop)
            if prop == 'bg' then return g.BackgroundTransparency
            elseif prop == 'text' then return g.TextTransparency
            elseif prop == 'img' then return g.ImageTransparency
            elseif prop == 'stroke' then return g.Transparency
            else return g.ScrollBarImageTransparency end
        end
        local function baseOf(g, prop)
            local b = baseTransp[g]
            if not b then b = {}; baseTransp[g] = b end
            if b[prop] == nil then b[prop] = propOf(g, prop) end
            return b[prop]
        end
        -- record true originals BEFORE the fade moves anything (close INCLUDED).
        -- baseOf caches the first value it sees, so if the first sighting is an
        -- OPEN (elements already faded to 1), the cache records 1 as the
        -- "original" and the reopen goes 1->1 — every section on the active tab
        -- stays invisible forever. Recording on close captures the natural value.
        for _, g in ipairs(bgs) do baseOf(g, 'bg') end
        for _, g in ipairs(texts) do baseOf(g, 'text') end
        for _, g in ipairs(imgs) do baseOf(g, 'img') end
        for _, g in ipairs(strokes) do baseOf(g, 'stroke') end
        for _, g in ipairs(scrolls) do baseOf(g, 'scroll') end
        local rootB = baseOf(root, 'bg') or 0
        local rootCur = root.BackgroundTransparency
        local t0 = tick()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if activeFade ~= conn then
                conn:Disconnect()  -- superseded by a newer fade; stop for good
                return
            end
            local p = math.min(1, (tick() - t0) / dur)
            p = 1 - (1 - p) * (1 - p)  -- quad out
            root.BackgroundTransparency = rootCur + (opening and (rootB - rootCur) or (1 - rootCur)) * p
            for i, g in ipairs(bgs) do
                g.BackgroundTransparency = curB[i] + (opening and (baseOf(g, 'bg') - curB[i]) or (1 - curB[i])) * p
            end
            for i, g in ipairs(texts) do
                g.TextTransparency = curT[i] + (opening and (baseOf(g, 'text') - curT[i]) or (1 - curT[i])) * p
            end
            for i, g in ipairs(imgs) do
                g.ImageTransparency = curI[i] + (opening and (baseOf(g, 'img') - curI[i]) or (1 - curI[i])) * p
            end
            for i, g in ipairs(strokes) do
                g.Transparency = curS[i] + (opening and (baseOf(g, 'stroke') - curS[i]) or (1 - curS[i])) * p
            end
            for i, g in ipairs(scrolls) do
                g.ScrollBarImageTransparency = curSc[i] + (opening and ((baseOf(g, 'scroll') or 0.35) - curSc[i]) or (1 - curSc[i])) * p
            end
            if p >= 1 then
                conn:Disconnect()
                if activeFade == conn then activeFade = nil end
                if opening then
                    -- restore exact originals so nothing stays dimmed
                    for _, g in ipairs(bgs) do g.BackgroundTransparency = baseOf(g, 'bg') end
                    for _, g in ipairs(texts) do g.TextTransparency = baseOf(g, 'text') end
                    for _, g in ipairs(imgs) do g.ImageTransparency = baseOf(g, 'img') end
                    for _, g in ipairs(strokes) do g.Transparency = baseOf(g, 'stroke') end
                    for _, g in ipairs(scrolls) do g.ScrollBarImageTransparency = baseOf(g, 'scroll') or 0.35 end
                    root.BackgroundTransparency = rootB
                end
            end
        end)
        -- register THIS connection as the running fade BEFORE the first
        -- heartbeat fires — without this, activeFade stays nil, the guard
        -- above always matches, and the fade kills itself on frame one
        -- (the close/open animation never plays, the window just snaps).
        activeFade = conn
    end

    function WindowMeta:Toggle(value)
        -- never use `and/or` here: an explicit Toggle(false) while Toggled is
        -- already false would compute `false or (not false)` == true and OPEN
        -- the window instead of closing it (fresh windows start Toggled=false)
        local target
        if value ~= nil then
            target = value
        else
            target = not PongiUI.Toggled
        end
        PongiUI.Toggled = target
        local root = self._root
        fadeGen = fadeGen + 1
        if target then
            root.Visible = true
            -- pop-in: start slightly smaller, overshoot to full size with
            -- Back easing (the window "pops" open instead of just fading)
            local bs = self._size or UDim2.fromOffset(620, 572)
            -- UDim2 * number is not supported on this client — scale the
            -- offsets manually (a raw multiply here breaks the reopen: the
            -- pop errors, the fade never runs and the window comes back as
            -- an empty black box)
            root.Size = UDim2.fromOffset(bs.X.Offset * 0.92, bs.Y.Offset * 0.92)
            tween(root, { Size = bs }, 0.3)  -- no Back easing: the pop shouldn't bounce
            fadeWindow(root, true, 0.25)
        else
            fadeWindow(root, false, 0.125)  -- close is 2x faster than open
            local gen = fadeGen
            task.delay(0.125, function()
                -- if the window was toggled again before the hide fired, skip
                -- (otherwise the delayed hide kills the freshly reopened UI)
                if gen ~= fadeGen or PongiUI.Toggled then return end
                root.Visible = false
                root.BackgroundTransparency = 0
            end)
        end
        return target
    end
    PongiUI.Toggle = function(self, value)
        if Window then Window:Toggle(value) end
    end

    -- the toggle keybind: accepts a KeyCode OR the picker table the script
    -- stores in PongiUI.Options (pressing the bound key toggles the window)
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Unknown then return end
        if captureCount > 0 then return end
        if LoadingActive then return end  -- no toggling while the loading screen is up
        local kb = PongiUI.ToggleKeybind
        local key = nil
        if typeof(kb) == 'EnumItem' then
            key = kb
        elseif type(kb) == 'table' and kb._key then
            key = kb._key
        end
        if key and input.KeyCode == key and input.UserInputState == Enum.UserInputState.Begin then
            if Window then Window:Toggle() end
        end
    end)

    function WindowMeta:AddTab(name, icon)
        local btn = Instance.new('TextButton')
        btn.Size = UDim2.fromOffset(measure(name, 13) + 24, 32)
        btn.BackgroundColor3 = theme.main2
        btn.BorderSizePixel = 0
        btn.Text = name
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.TextColor3 = theme.font
        btn.TextXAlignment = Enum.TextXAlignment.Center
        corner(btn, 7)
        local btnStroke = stroke(btn, theme.outline, 1)
        btn.Parent = self._tabRow

        local function makeCanvas()
            local sf = Instance.new('ScrollingFrame')
            sf.Size = UDim2.new(1, 0, 1, 0)
            sf.BackgroundTransparency = 1
            sf.BorderSizePixel = 0
            sf.ScrollBarThickness = 4
            sf.ScrollBarImageColor3 = Color3.fromRGB(185, 185, 200)
            sf.ScrollingDirection = Enum.ScrollingDirection.Y
            sf.ScrollBarImageTransparency = 0.35
            local pad = Instance.new('UIPadding')
            pad.PaddingTop = UDim.new(0, 4)
            pad.PaddingBottom = UDim.new(0, 6)
            -- thin side padding: enough for the outlines, keeps the sections
            -- visually aligned with the tab row (less left/right margin)
            pad.PaddingLeft = UDim.new(0, 2)
            pad.PaddingRight = UDim.new(0, 5)  -- scrollbar side gets a bit more
            pad.Parent = sf
            local list = Instance.new('UIListLayout')
            list.Padding = UDim.new(0, 8)
            list.SortOrder = Enum.SortOrder.LayoutOrder
            list.Parent = sf
            -- AutomaticCanvasSize is unreliable on some clients — size the
            -- canvas manually from the list layout so content never clips
            local function updateCanvas()
                pcall(function()
                    local c = list.AbsoluteContentSize
                    sf.CanvasSize = UDim2.new(0, c.X, 0, c.Y + pad.PaddingTop.Offset + pad.PaddingBottom.Offset)
                end)
            end
            list:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(updateCanvas)
            task.defer(updateCanvas)
            return sf, list
        end

        local tab: any = {
            _name = name,
            _btn = btn,
            _left = Instance.new('ScrollingFrame'),
            _right = Instance.new('ScrollingFrame'),
            _visible = false,
            _owner = self,
        }
        tab._left = makeCanvas()
        tab._right = makeCanvas()
        -- parent the canvases NOW (hidden) instead of lazily on first Show:
        -- a never-shown tab's elements must still be descendants of the
        -- window root, or the fade skips them, their base transparencies
        -- are never recorded, and after a close/reopen they come back
        -- stuck invisible ("sections deleted on the other tab")
        tab._left.Parent = self._left
        tab._right.Parent = self._right
        tab._left.Visible = false
        tab._right.Visible = false

        local TabMeta = {}
        TabMeta.__index = TabMeta

        function TabMeta:Show()
            if tab._visible then return end
            tab._visible = true
            for _, t in ipairs(self._owner._tabs) do
                if t ~= tab then t:Hide() end
            end
            tab._left.Parent = self._owner._left
            tab._right.Parent = self._owner._right
            tab._left.Visible = true
            tab._right.Visible = true
            tab._btn.BackgroundColor3 = theme.accent
            tab._btn.TextColor3 = Color3.new(1, 1, 1)
            btnStroke.Color = theme.accent2
        end

        function TabMeta:Hide()
            tab._visible = false
            tab._left.Visible = false
            tab._right.Visible = false
            tab._btn.BackgroundColor3 = theme.main2
            tab._btn.TextColor3 = theme.font
            btnStroke.Color = theme.outline
        end

        function TabMeta:AddLeftGroupbox(name, icon)
            return GroupboxFactory(tab._left, name, icon)
        end
        function TabMeta:AddRightGroupbox(name, icon)
            return GroupboxFactory(tab._right, name, icon)
        end

        tab = setmetatable(tab, TabMeta)
        table.insert(self._tabs, tab)
        btn.Activated:Connect(function()
            tab:Show()
        end)
        if #self._tabs == 1 then
            tab:Show()
        end
        return tab
    end

    function WindowMeta:AddDialog(idx, info)
