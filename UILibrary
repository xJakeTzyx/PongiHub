                tween(o, { BackgroundTransparency = 1 }, 0.3)
                if box then
                    -- fade the box and everything in it too — no instant pop
                    tween(box, { BackgroundTransparency = 1 }, 0.3)
                    for _, g in ipairs(box:GetDescendants()) do
                        if g:IsA('Frame') then tween(g, { BackgroundTransparency = 1 }, 0.3) end
                        if g:IsA('TextLabel') then tween(g, { TextTransparency = 1 }, 0.3) end
                        if g:IsA('ImageLabel') then tween(g, { ImageTransparency = 1 }, 0.3) end
                        if g:IsA('UIStroke') then tween(g, { Transparency = 1 }, 0.3) end
                    end
                end
            end)
            task.delay(0.3, function()
                o:Destroy()
                -- strictly sequential: loading screen gone FIRST, then the
                -- window fades in (they never overlap on screen)
                if Window then
                    pcall(function() Window:Toggle(true) end)
                end
            end)
        end
        loading.Continue = LoadingMeta.Destroy
        return setmetatable(loading, LoadingMeta)
    end

    -- ── key/license window — the auth layer calls this instead of building
    -- its own box (same style as the loading screen: logo, title, status,
    -- spinner + key input + Redeem; pop-in, drag strip, fade-out destroy) ──
    function PongiUI:CreateKeyWindow(info)
        info = info or {}
        local sg = Instance.new('ScreenGui')
        sg.Name = randName()
        sg:SetAttribute('PongihubAuth', true)
        sg.ResetOnSpawn = false
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        sg.Parent = CoreGui:FindFirstChild('RobloxGui') or CoreGui

        -- NO fullscreen overlay: on mobile, a full-screen frame (even
        -- transparent) consumes the touch hit-test, so Bloxburg's dynamic
        -- joystick never spawns and the player is stuck. The overlay had
        -- no function (no outside-click handler) — box goes straight in.
        local box = Instance.new('Frame', sg)
        box.Size = UDim2.fromOffset(340, 172)
        box.AnchorPoint = Vector2.new(0.5, 0.5)
        box.Position = UDim2.fromScale(0.5, 0.5)
        box.BackgroundColor3 = theme.main
        box.BorderSizePixel = 0
        corner(box, 10)
        stroke(box, theme.outline, 1)

        local logo = makeIcon(info.Icon or 'user', 46)
        logo.Position = UDim2.fromOffset(18, 18)
        logo.Parent = box
        local title = newFont(18)
        title.Size = UDim2.new(1, -80, 0, 24)
        title.Position = UDim2.fromOffset(76, 14)
        title.RichText = true
        -- same [FREE]/[PREMIUM] coloring as the main window title (both grey)
        title.Text = (info.Title or 'PongiHub Premium')
            :gsub('%[FREE%]', '<font color="#9d97b8">[FREE]</font>')
            :gsub('%[PREMIUM%]', '<font color="#9d97b8">[PREMIUM]</font>')
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = box
        local status = newFont(14)
        status.Font = Enum.Font.Code  -- same font as the key input placeholder
        status.Size = UDim2.new(1, -80, 0, 18)
        status.Position = UDim2.fromOffset(76, 41)
        status.Text = info.Status or 'Enter your license key'
        status.TextColor3 = theme.font
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.Parent = box
        local spin = PongiUI:CreateSpinner(22)
        spin.Frame.Position = UDim2.new(1, -44, 0, 16)
        spin.Frame.Parent = box

        local kb = Instance.new('TextBox', box)
        kb.Size = UDim2.new(1, -36, 0, 34)
        kb.Position = UDim2.fromOffset(18, 80)
        kb.BackgroundColor3 = theme.main2
        kb.BorderSizePixel = 0
        kb.Text = ''
        kb.PlaceholderText = 'paste your key here'
        kb.PlaceholderColor3 = theme.dim
        kb.TextColor3 = theme.font
        kb.Font = Enum.Font.Code
        kb.TextSize = 16
        kb.ClearTextOnFocus = false
        corner(kb, theme.radius)
        stroke(kb, theme.outline, 1)

        -- Get Key opens the free-key site (left) / Redeem validates (right)
        local getUrl = info.GetKeyUrl or 'https://pongihub-free.pongihub.workers.dev'
        local function openGetKey()
            local opened = false
            if request_browser_url then
                opened = pcall(request_browser_url, getUrl)
            end
            if not opened then
                pcall(function()
                    if setclipboard then setclipboard(getUrl) end
                end)
                status.Text = 'Link copied - paste it in your browser'
                status.TextColor3 = theme.font
            end
        end
        local btnGet = Instance.new('TextButton', box)
        btnGet.Size = UDim2.new(0.5, -22, 0, 34)
        btnGet.Position = UDim2.fromOffset(18, 122)
        btnGet.BackgroundColor3 = theme.main2
        btnGet.BorderSizePixel = 0
        btnGet.Text = 'Get Key'
        btnGet.TextColor3 = theme.font
        btnGet.Font = Enum.Font.Gotham
        btnGet.TextSize = 14
        corner(btnGet, theme.radius)
        btnGet.MouseButton1Click:Connect(openGetKey)

        local btn = Instance.new('TextButton', box)
        btn.Size = UDim2.new(0.5, -22, 0, 34)
        btn.Position = UDim2.fromOffset(174, 122)
        btn.BackgroundColor3 = theme.accent
        btn.BorderSizePixel = 0
        btn.Text = 'Redeem Key'
        btn.TextColor3 = theme.white
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        corner(btn, theme.radius)
        btn.MouseEnter:Connect(function()
            if btn.Active then tween(btn, { BackgroundColor3 = theme.accent2 }, 0.15) end
        end)
        btn.MouseLeave:Connect(function()
            if btn.Active then tween(btn, { BackgroundColor3 = theme.accent }, 0.15) end
        end)
        btn.MouseButton1Click:Connect(function()
            local key = tostring(kb.Text):gsub('%s', ''):upper()
            if key == '' then
                status.Text = 'Enter your key'
                status.TextColor3 = theme.red
                return
            end
            if #key < 8 then
                status.Text = 'Invalid key'
                status.TextColor3 = theme.red
                return
            end
            btn.Text = 'Redeeming...'
            btn.BackgroundColor3 = theme.accent2
            btn.Active = false
            if info.onSubmit then info.onSubmit(key) end
        end)

        -- drag: menu pattern (top strip only)
        local dragStrip = Instance.new('Frame', box)
        dragStrip.Size = UDim2.new(1, 0, 0, 70)
        dragStrip.BackgroundTransparency = 1
        dragStrip.BorderSizePixel = 0
        local dragging = false
        local dragOffset = Vector2.new(0, 0)
        dragStrip.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local p = input.Position
                local anchor = box.AbsolutePosition + box.AbsoluteSize * box.AnchorPoint
                dragOffset = Vector2.new(p.X, p.Y) - anchor
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            -- mobile fires BOTH MouseMovement AND Touch per finger move —
            -- handle only one input type to avoid jitter
            if dragging and (
                (UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.Touch)
                or (not UserInputService.TouchEnabled and input.UserInputType == Enum.UserInputType.MouseMovement)
            ) then
                local p = input.Position
                box.Position = UDim2.fromOffset(p.X - dragOffset.X, p.Y - dragOffset.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        -- pop-in (same smooth feel as the loading screen reveal): every
        -- element exists now — scale up AND fade everything in together, no
        -- instant opaque box. Frames are left alone so the transparent drag
        -- strip stays invisible.
        box.Size = UDim2.fromOffset(340 * 0.9, 172 * 0.9)
        box.BackgroundTransparency = 1
        tween(box, { Size = UDim2.fromOffset(340, 172), BackgroundTransparency = 0 }, 0.25)
        local openStroke = box:FindFirstChildOfClass('UIStroke')
        if openStroke then tween(openStroke, { Transparency = 0 }, 0.25) end
        for _, g in ipairs(box:GetDescendants()) do
            if g:IsA('TextButton') or g:IsA('TextBox') then
                g.TextTransparency = 1
                g.BackgroundTransparency = 1
                tween(g, { TextTransparency = 0, BackgroundTransparency = 0 }, 0.25)
            elseif g:IsA('TextLabel') then
                g.TextTransparency = 1
                tween(g, { TextTransparency = 0 }, 0.25)
            elseif g:IsA('ImageLabel') then
                g.ImageTransparency = 1
                tween(g, { ImageTransparency = 0 }, 0.25)
            end
        end

        local handle = {}
        function handle:SetStatus(t, c)
            status.Text = tostring(t)
            if c then status.TextColor3 = c end
        end
        function handle:SetSpinning(on)
            spin.Frame.Visible = on
            spin:SetBusy(on)
        end
        function handle:SetBtnText(t)
            btn.Text = tostring(t)
        end
        function handle:SetBtnActive(a)
            btn.Active = a
            if a then btn.BackgroundColor3 = theme.accent end
        end
        function handle:Destroy()
            if not sg then return end
            local s = sg
            sg = nil
            -- smooth close (same 0.3s feel as the loading screen): fade the
            -- box AND every element together, shrink slightly, then destroy
            pcall(function()
                tween(box, { BackgroundTransparency = 1, Size = UDim2.fromOffset(340 * 0.92, 172 * 0.92) }, 0.3)
                for _, g in ipairs(box:GetDescendants()) do
                    if g:IsA('TextButton') or g:IsA('TextBox') then
                        tween(g, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.3)
                    elseif g:IsA('Frame') then
                        tween(g, { BackgroundTransparency = 1 }, 0.3)
                    elseif g:IsA('TextLabel') then
                        tween(g, { TextTransparency = 1 }, 0.3)
                    elseif g:IsA('ImageLabel') then
                        tween(g, { ImageTransparency = 1 }, 0.3)
                    elseif g:IsA('UIStroke') then
                        tween(g, { Transparency = 1 }, 0.3)
                    end
                end
            end)
            task.delay(0.32, function()
                pcall(function() s:Destroy() end)
            end)
        end
        return handle
    end

    -- live icon-size tuning: resize ONLY the groupbox icon IMAGE on the fly,
    -- and persist the choice for the next build via _G.PONGI_GROUPBOX_ICON_SIZE.
    -- The 34px header row and title stay untouched. Call from a Settings input
    -- while testing.
    function PongiUI:SetGroupboxIconSize(n)
        n = tonumber(n)
        if not n or n < 14 or n > 48 then return false end
        GROUPBOX_ICON_SIZE = math.floor(n)
        if _G then _G.PONGI_GROUPBOX_ICON_SIZE = GROUPBOX_ICON_SIZE end
        for _, e in ipairs(registeredGroupboxIcons) do
            pcall(function()
                if e.holder then
                    e.holder.Size = UDim2.fromOffset(GROUPBOX_ICON_SIZE, GROUPBOX_ICON_SIZE)
                    e.holder.Position = UDim2.fromOffset(10, math.max(0, (34 - GROUPBOX_ICON_SIZE) / 2))
                    -- the inner image/text scales automatically (UDim2 1,-6)
                end
            end)
        end
        return true
    end

    function PongiUI:Notify(info)
        info = info or {}
        -- transparent wrapper sits in the notify stack (the UIListLayout owns
        -- its position); the CARD slides inside the wrapper, so the layout
        -- can never fight the slide animation
        local holder = Instance.new('Frame')
        holder.Size = UDim2.fromOffset(300, 0)
        holder.BackgroundTransparency = 1
        holder.BorderSizePixel = 0
        holder.ZIndex = 210
        holder.Parent = NotifyArea

        local card = Instance.new('Frame')
        card.Size = UDim2.new(1, 0, 0, 0)
        card.BackgroundColor3 = theme.main
        card.BorderSizePixel = 0
        corner(card, 10)
        stroke(card, theme.outline, 1)
        card.ClipsDescendants = true
        card.Parent = holder

        -- roomy, balanced padding: the same top margin above the title and
        -- bottom margin below the text (before the timer line)
        local title = newFont(14)
        title.Size = UDim2.new(1, -32, 0, 18)
        title.Position = UDim2.fromOffset(16, 12)
        title.Text = info.Title or ''
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = card
        local desc = newFont(13)
        desc.Size = UDim2.new(1, -32, 0, 0)
        desc.Position = UDim2.fromOffset(16, 34)
        desc.Text = info.Description or ''
        desc.TextWrapped = true
        desc.LineHeight = 1.15
        desc.TextColor3 = theme.font
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextYAlignment = Enum.TextYAlignment.Top
        desc.Parent = card

        -- TextBounds on a 0-height label does NOT wrap on this client (it
        -- reports a single line), so the card would stay minimum-height and
        -- ClipsDescendants would cut the wrapped lines. Measure the wrapped
        -- text with TextService instead so the card always fits its text.
        local innerW = 268
        -- the label renders with LineHeight 1.15, but TextService:GetTextSize does
        -- NOT apply LineHeight — so measured height under-counts the real wrapped
        -- height and long texts get their last line(s) clipped by the card.
        -- Scale the measured height by the label's LineHeight (+1px rounding
        -- headroom) so the card always fits the full text.
        local lineH = desc.LineHeight or 1
        local bounds = TPS:GetTextSize(desc.Text, desc.TextSize, desc.Font, Vector2.new(innerW, 1000))
        local h = math.max(76, 56 + math.ceil(bounds.Y * lineH) + 1)
        holder.Size = UDim2.fromOffset(300, h)
        card.Size = UDim2.new(1, 0, 0, h)
        -- the desc needs a REAL height: a 0-height wrapped label does not
        -- render every line on this client even when the card is tall
        desc.Size = UDim2.new(1, -32, 0, math.max(20, h - 56))
        -- re-measure once more after the first layout pass (fonts can settle
        -- late); same TextService measurement, never the stale TextBounds
        task.defer(function()
            pcall(function()
                local need = 56 + math.ceil(TPS:GetTextSize(desc.Text, desc.TextSize, desc.Font, Vector2.new(innerW, 1000)).Y * lineH) + 1
                if need > h then
                    h = need
                    holder.Size = UDim2.fromOffset(300, h)
                    card.Size = UDim2.new(1, 0, 0, h)
                    desc.Size = UDim2.new(1, -32, 0, math.max(20, h - 56))
                end
            end)
        end)
        local t = info.Time or 3
        -- the timer sits INSIDE the card: thin line with left/right/bottom
        -- margins, full at open, drains left->right to nothing
        local timerFill = Instance.new('Frame')
        timerFill.Size = UDim2.new(1, -16, 0, 2)
        timerFill.Position = UDim2.new(0, 8, 1, -8)
        timerFill.BackgroundColor3 = theme.accent
        timerFill.BorderSizePixel = 0
        corner(timerFill, 1)
        timerFill.Parent = card

        -- open: slide in from off-screen right + fade the card in (2.1x speed)
        card.BackgroundTransparency = 1
        card.Position = UDim2.fromOffset(320, 0)
        tween(card, { BackgroundTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.17)
        -- countdown: full -> empty, Linear over the whole duration
        tween(timerFill, { Size = UDim2.new(0, 0, 0, 2) }, t, Enum.EasingStyle.Linear)
        task.delay(t + 0.1, function()
            -- close: slide out with the card AND its text fading together
            pcall(function()
                tween(card, { BackgroundTransparency = 1 }, 0.14)
                tween(title, { TextTransparency = 1 }, 0.14)
                tween(desc, { TextTransparency = 1 }, 0.14)
                tween(timerFill, { BackgroundTransparency = 1 }, 0.14)
                local hs = card:FindFirstChildOfClass('UIStroke')
                if hs then tween(hs, { Transparency = 1 }, 0.14) end
            end)
            tween(card, { Position = UDim2.fromOffset(320, 0) }, 0.14)
            task.delay(0.18, function()
                holder:Destroy()
            end)
        end)
        return holder
    end

    return PongiUI
