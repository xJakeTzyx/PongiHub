    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    -- explorer hiding, best-effort per executor (never breaks rendering):
    --   protectgui()  — Synapse-family; makes the instance invisible to the
    --                   explorer outright (guarded: absent on Delta etc.)
    --   gethui()      — parents into the executor's hidden container (Delta
    --                   renders it full-screen and the explorer never shows
    --                   it). NOT used on Real: there gethui() resolves to
    --                   CoreGui.RobloxGui, which renders off-center in an
    --                   828x942 space — so skip any container that IS that.
    --   fallback      — plain CoreGui + random name (Real, unknown executors)
    local hidden = hiddenUI()
    if hidden and hidden ~= CoreGui:FindFirstChild('RobloxGui') and hidden ~= CoreGui then
        ScreenGui.Parent = hidden
    else
        ScreenGui.Parent = CoreGui:FindFirstChild('RobloxGui') or CoreGui
    end
    for _, fnName in ipairs({ 'protectgui', 'protect_gui' }) do
        local fn = (getgenv and getgenv()[fnName]) or _G[fnName]
        if type(fn) == 'function' then
            local ok = pcall(fn, ScreenGui)
            if ok then break end
        end
    end

