    -- SPINNER — a rotating ring with chasing dots (the Build Status look).
    --   local sp = PongiUI:CreateSpinner(24, color)   -> { Frame, SetBusy }
    --   sp.Frame.Parent = someFrame
    --   sp:SetBusy(true)  -- show + start spinning
    --   sp:SetBusy(false) -- hide (the rotation chain stops itself)
    -- ══════════════════════════════════════════════════════════════════
    function PongiUI:CreateSpinner(size, color)
        local col = color or Color3.fromRGB(150, 100, 230)
        local spinner = Instance.new('Frame')
        spinner.BackgroundTransparency = 1
        spinner.Size = UDim2.fromOffset(size or 24, size or 24)
        spinner.Visible = false
        local ring = Instance.new('Frame')
        ring.Size = UDim2.new(1, 0, 1, 0)
        ring.BackgroundTransparency = 1
        ring.BorderSizePixel = 2.5
        ring.BorderColor3 = col
        Instance.new('UICorner', ring).CornerRadius = UDim.new(1, 0)
        ring.Parent = spinner
        local SPIN_FADE = {0, 0.25, 0.5, 0.7, 0.8, 0.85, 0.85, 0.85, 0.85, 0.85}
        for i = 1, 10 do
            local seg = Instance.new('Frame')
            seg.Size = UDim2.fromOffset(3, 3)
            seg.AnchorPoint = Vector2.new(0.5, 0.5)
            local ang = math.rad((i - 1) * 36)
            seg.Position = UDim2.new(0.5, math.sin(ang) * 8.5, 0.5, -math.cos(ang) * 8.5)
            seg.BackgroundColor3 = col
            seg.BackgroundTransparency = SPIN_FADE[i]
            seg.BorderSizePixel = 0
            Instance.new('UICorner', seg).CornerRadius = UDim.new(1, 0)
            seg.Parent = spinner
        end
        local spinTween = nil
        local function spinLoop()
            if not spinner or not spinner.Visible or not spinner.Parent then
                spinTween = nil
                return
            end
            if spinTween then return end
            local old = setthreadidentity and getthreadidentity() or 8
            if setthreadidentity then setthreadidentity(8) end
            pcall(function()
                spinTween = TweenService:Create(spinner,
                    TweenInfo.new(0.8, Enum.EasingStyle.Linear),
                    { Rotation = spinner.Rotation + 360 })
                spinTween.Completed:Connect(function()
                    spinTween = nil
                    local old2 = setthreadidentity and getthreadidentity() or 8
                    if setthreadidentity then setthreadidentity(8) end
                    spinLoop()
                    if setthreadidentity then setthreadidentity(old2) end
                end)
                spinTween:Play()
            end)
            if setthreadidentity then setthreadidentity(old) end
        end
        local obj = {
            Frame = spinner,
            SetBusy = function(_, busy)
                spinner.Visible = busy
                if busy then spinLoop() end
            end,
        }
        return obj
    end

    function PongiUI:CreateLoading(info)
