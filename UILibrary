    -- TweenService:Create needs Plugin capability — elevate like the
    -- rest of the script does for its own UI work
    local function tween(inst, props, dur, style)
        local old = setthreadidentity and getthreadidentity() or 8
        if setthreadidentity then setthreadidentity(8) end
        pcall(function()
            TweenService:Create(inst, TweenInfo.new(dur or 0.2,
                style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
        end)
        if setthreadidentity then setthreadidentity(old) end
    end

    local function corner(inst, r)
        local c = Instance.new('UICorner')
        c.CornerRadius = UDim.new(0, r or theme.radius)
        c.Parent = inst
        return c
    end

    local function stroke(inst, color, thick)
        local s = Instance.new('UIStroke')
        s.Color = color or theme.outline
        s.Thickness = thick or 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = inst
        return s
    end

    local function newFont(size, bold)
        local l = Instance.new('TextLabel')
        l.Font = Enum.Font.Gotham
        l.TextSize = size or 14
        l.TextColor3 = theme.font
        l.BackgroundTransparency = 1
        l.BorderSizePixel = 0
        if bold then l.Font = Enum.Font.GothamBold end
        return l
    end

    -- ── animated box background: near-black base + slow-drifting purple
    -- glows (UIGradient circles, no image assets) clipped INSIDE the card,
    -- so each UI's OWN background feels alive. Frames sit at ZIndex 0 —
    -- always under the box's content. The drift loops stop when the box dies.
    local function addBoxAmbient(box)
        box.ClipsDescendants = true
        local layer = Instance.new('Frame')
        layer.Name = 'BoxAmbient'
        layer.Size = UDim2.new(1, 0, 1, 0)
        layer.BackgroundTransparency = 1
        layer.BorderSizePixel = 0
        layer.ZIndex = 0
        layer.Parent = box
        local specs = {
            { theme.accent,  UDim2.new(0.8, 0, 0.8, 0),  UDim2.new(0.08, 0, 0.05, 0), UDim2.new(0.35, 0, 0.28, 0), 6, 18, 0.90 },
            { theme.accent2, UDim2.new(0.65, 0, 0.65, 0), UDim2.new(0.88, 0, 0.08, 0), UDim2.new(0.62, 0, 0.32, 0), 7, -12, 0.93 },
            { theme.accent,  UDim2.new(0.55, 0, 0.55, 0), UDim2.new(0.7, 0, 0.88, 0),  UDim2.new(0.42, 0, 0.62, 0), 8, 30, 0.94 },
        }
        for _, sp in ipairs(specs) do
            local g = Instance.new('Frame')
            g.Size = sp[2]
            g.AnchorPoint = Vector2.new(0.5, 0.5)
            g.Position = sp[3]
            g.BackgroundColor3 = sp[1]
            g.BackgroundTransparency = sp[7]
            g.BorderSizePixel = 0
            g.Rotation = sp[6]
            g.ZIndex = 0
            corner(g, 999)
            local grad = Instance.new('UIGradient')
            grad.Rotation = 90
            grad.Color = ColorSequence.new(sp[1], theme.dark)
            grad.Parent = g
            g.Parent = layer
            local from, to, dur = sp[3], sp[4], sp[5]
            task.spawn(function()
                while g.Parent do
                    tween(g, { Position = to }, dur, Enum.EasingStyle.Sine)
                    task.wait(dur)
                    tween(g, { Position = from }, dur, Enum.EasingStyle.Sine)
                    task.wait(dur)
                end
            end)
        end
    end

