        body.ZIndex = 62
        body.Parent = dlg
        -- pad the row area so each row's 1px UIStroke has room to render;
        -- a ScrollingFrame clips at its viewport edges, so a full-width row
        -- loses its top/left/right border lines
        local bodyPad = Instance.new('UIPadding')
        bodyPad.PaddingTop = UDim.new(0, 4)
        bodyPad.PaddingBottom = UDim.new(0, 4)
        bodyPad.PaddingLeft = UDim.new(0, 4)
        bodyPad.PaddingRight = UDim.new(0, 4)
        bodyPad.Parent = body
        local bodyList = Instance.new('UIListLayout')
        bodyList.SortOrder = Enum.SortOrder.LayoutOrder
        bodyList.Padding = UDim.new(0, 8)
        bodyList.Parent = body

        local btnRow = Instance.new('Frame')
        btnRow.Size = UDim2.new(1, -28, 0, 36)
        btnRow.Position = UDim2.new(0, 14, 1, -40)  -- lower margin, still inside the box
        btnRow.BackgroundTransparency = 1
        btnRow.ZIndex = 62
        btnRow.Parent = dlg
        local btnList = Instance.new('UIListLayout')
        btnList.FillDirection = Enum.FillDirection.Horizontal
        btnList.HorizontalAlignment = Enum.HorizontalAlignment.Right
        btnList.Padding = UDim.new(0, 8)
        btnList.SortOrder = Enum.SortOrder.LayoutOrder
        btnList.Parent = btnRow

        local dialog = {
            _overlay = overlay,
            _dlg = dlg,
            _desc = desc,
            _body = body,
            _bodyList = bodyList,
            _bodyH = 0,
            _w = info.Width or 380,
            _btnRow = btnRow,
            _buttons = {},
        }
        local DialogMeta = {}
        DialogMeta.__index = DialogMeta

        function DialogMeta:AddFooterButton(btnIdx, btnInfo)
            local b = Instance.new('TextButton')
            b.Size = UDim2.fromOffset(68, 26)  -- ~75% of the old 90x34
            b.BackgroundColor3 = btnInfo.Variant == 'Secondary' and theme.main2 or theme.accent
            b.BorderSizePixel = 0
            b.Text = btnInfo.Title or 'Button'
            b.Font = Enum.Font.Gotham
            b.TextSize = 12
            b.TextColor3 = btnInfo.Variant == 'Secondary' and theme.font or Color3.new(1, 1, 1)
            corner(b, 7)
            if btnInfo.Variant == 'Secondary' then stroke(b, theme.outline, 1) end
            b.ZIndex = 63
            b.Parent = self._btnRow
            b.Activated:Connect(function()
                if btnInfo.Callback then
                    btnInfo.Callback()
                end
                self:Dismiss()
            end)
            self._buttons[btnIdx] = b
        end

        function DialogMeta:Resize()
            -- wrap-measure with TextService (TextBounds doesn't wrap on this
            -- client) AND give the description a real height — a short label
            -- never renders all its wrapped lines, so long requirement lists
            -- (the "Are you sure?" popup) grow the dialog instead of hiding
            local d = self._desc
            local W = self._w or 380
            local bodyH = self._bodyH or 0
            local bounds = TPS:GetTextSize(d.Text, d.TextSize, d.Font, Vector2.new(W - 28, 1000))
            -- an EMPTY description (dialogs that only have number rows) must
            -- collapse the text area entirely — otherwise a 44px+ blank gap
            -- sits between the title and the rows and the popup looks off
            local hasDesc = d.Text ~= nil and d.Text ~= ''
            if bodyH <= 0 then
                -- no custom rows — keep the ORIGINAL sizing exactly, so
                -- regular dialogs ("Are you sure?" etc.) stay unchanged
                local h = math.max(150, bounds.Y + 96)
                self._dlg.Size = UDim2.fromOffset(W, h)
                if hasDesc then
                    self._desc.Size = UDim2.new(1, -28, 0, math.max(60, h - 96))
                else
                    self._desc.Size = UDim2.new(1, -28, 0, 0)
                end
                self._btnRow.Position = UDim2.new(0, 14, 1, -40)
                return
            end
            -- with custom rows: grow the dialog, cap the row area at 200px
            -- and let the body scrollbar handle any overflow
            local descH = hasDesc and math.max(44, bounds.Y + 12) or 0
            local visibleBodyH = math.min(bodyH, 200)
            local h = 14 + 24 + 10 + descH + 8 + visibleBodyH + 12 + 36 + 12
            self._dlg.Size = UDim2.fromOffset(W, h)
            self._desc.Size = UDim2.new(1, -28, 0, descH)
            self._body.Size = UDim2.new(1, -28, 0, visibleBodyH)
            self._body.Position = UDim2.new(0, 14, 0, 14 + 24 + 10 + descH)
            self._body.CanvasSize = UDim2.fromOffset(0, math.max(0, bodyH) + 8)  -- + padding top/bottom
            self._btnRow.Position = UDim2.new(0, 14, 1, -40)
        end

        -- 2nd-type text holder: a row that looks like a button — title on
        -- the left, a small numeric input on the right (used by the Auto
        -- Farm job config popup). Sanitizes to digits and clamps Min/Max.
        function DialogMeta:AddNumberRow(id, info)
            info = info or {}
            local row = Instance.new('Frame')
            row.Size = UDim2.new(1, -8, 0, 32)  -- inset so the stroke fits inside the padded body
            row.BackgroundColor3 = theme.main2
            row.BorderSizePixel = 0
            corner(row, 7)
            stroke(row, theme.outline, 1)
            row.ZIndex = 62
            row.Parent = self._body
            local lbl = newFont(13)
            lbl.Size = UDim2.new(1, -92, 0, 32)
            lbl.Position = UDim2.fromOffset(10, 0)
            lbl.Text = info.Text or 'Value'
            lbl.TextColor3 = theme.font
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 63
            lbl.Parent = row
            local box = Instance.new('TextBox')
            box.Size = UDim2.fromOffset(66, 24)
            box.Position = UDim2.new(1, -76, 0, 4)
            box.BackgroundColor3 = theme.dark
            box.BorderSizePixel = 0
            box.Font = Enum.Font.Code
            box.TextSize = 13
            box.TextColor3 = Color3.new(1, 1, 1)
            box.TextXAlignment = Enum.TextXAlignment.Center
            corner(box, 6)
            box.ZIndex = 63
            box.Parent = row
            local val = tostring(info.Default or '')
            local function refresh()
                box.Text = val
            end
            refresh()
            box.FocusLost:Connect(function(enter)
                local n = tonumber((tostring(box.Text):match('%d+')) or '')
                if n then
                    if info.Min then n = math.max(info.Min, n) end
                    if info.Max then n = math.min(info.Max, n) end
                    n = math.floor(n)
                    val = tostring(n)
                    refresh()
                    if info.Callback then info.Callback(n) end
                else
                    refresh() -- revert to the last good value
                end
            end)
            self._bodyH = (self._bodyH or 0) + 32 + 8  -- matches UIListLayout Padding
            self:Resize()
            return {
                GetValue = function() return tonumber(val) end,
                SetValue = function(n)
                    val = tostring(math.floor(tonumber(n) or 0))
                    refresh()
                end,
            }
        end

        -- 2nd-type toggle holder: the same button-like row as AddNumberRow but with
        -- a switch on the right (used by the Auto Farm job config popup). The
        -- Callback may return `false` to refuse the flip (e.g. a bad game state) and
        -- the row reverts itself automatically.
        function DialogMeta:AddToggleRow(id, info)
            info = info or {}
            local row = Instance.new('Frame')
            row.Size = UDim2.new(1, -8, 0, 32)  -- inset so the stroke fits inside the padded body
            row.BackgroundColor3 = theme.main2
            row.BorderSizePixel = 0
            corner(row, 7)
            stroke(row, theme.outline, 1)
            row.ZIndex = 62
            row.Parent = self._body
            local lbl = newFont(13)
            lbl.Size = UDim2.new(1, -56, 0, 32)
            lbl.Position = UDim2.fromOffset(10, 0)
            lbl.Text = info.Text or 'Toggle'
            lbl.TextColor3 = theme.font
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 63
            lbl.Parent = row
            local bg = Instance.new('Frame')
            bg.Size = UDim2.fromOffset(40, 22)
            bg.Position = UDim2.new(1, -48, 0, 5)
            bg.BackgroundColor3 = theme.main2
            bg.BorderSizePixel = 0
            corner(bg, 11)
            stroke(bg, theme.outline, 1)
            bg.ZIndex = 63
            bg.Parent = row
            local knob = Instance.new('Frame')
            knob.Size = UDim2.fromOffset(18, 18)
            knob.Position = UDim2.fromOffset(2, 2)
            knob.BackgroundColor3 = theme.dim
            knob.BorderSizePixel = 0
            corner(knob, 9)
            knob.ZIndex = 64
            knob.Parent = bg
            local value = info.Default == true
            local function apply()
                if value then
                    tween(bg, { BackgroundColor3 = theme.accent }, 0.2)
                    tween(knob, { Position = UDim2.fromOffset(20, 2), BackgroundColor3 = Color3.new(1, 1, 1) }, 0.2)
                else
                    tween(bg, { BackgroundColor3 = theme.main2 }, 0.2)
                    tween(knob, { Position = UDim2.fromOffset(2, 2), BackgroundColor3 = theme.dim }, 0.2)
                end
            end
            apply()
            local btn = Instance.new('TextButton')
            btn.Size = UDim2.new(1, 0, 0, 32)
            btn.BackgroundTransparency = 1
            btn.BorderSizePixel = 0
            btn.Text = ''
            btn.ZIndex = 64
            btn.Parent = row
            btn.Activated:Connect(function()
                value = not value
                apply()
                if info.Callback then
                    local keep = info.Callback(value)
                    if keep == false then  -- refused -> flip back
                        value = not value
                        apply()
                    end
                end
            end)
            self._bodyH = (self._bodyH or 0) + 32 + 8  -- matches UIListLayout Padding
            self:Resize()
            return {
                Value = value,
                SetValue = function(_, v)
                    value = v == true
                    apply()
                end,
            }
        end

        function DialogMeta:Dismiss()
            local o = self._overlay
            local d = self._dlg
            -- one shared fade driver: every element (backgrounds, text, strokes)
            -- is moved from the SAME progress value, so nothing can drift out
            -- of sync no matter how many elements the dialog has (firing 30+
            -- separate tweens staggers text behind the box on some executors)
            local bgs, texts, strokes = {}, {}, {}
            local function collect(g)
                if g:IsA('Frame') or g:IsA('TextButton') or g:IsA('TextBox') then
                    bgs[#bgs+1] = g
                end
                if g:IsA('TextLabel') or g:IsA('TextButton') or g:IsA('TextBox') then
                    texts[#texts+1] = g
                end
                if g:IsA('UIStroke') then
                    strokes[#strokes+1] = g
                end
                for _, c in ipairs(g:GetChildren()) do collect(c) end
            end
            collect(d)
            local baseB = {}
            for i, g in ipairs(bgs) do baseB[i] = g.BackgroundTransparency end
            local baseT = {}
            for i, g in ipairs(texts) do baseT[i] = g.TextTransparency end
            local baseS = {}
            for i, g in ipairs(strokes) do baseS[i] = g.Transparency end
            local baseO = o.BackgroundTransparency
            local dur = 0.18
            local t0 = tick()
            local conn
            conn = RunService.Heartbeat:Connect(function()
                local p = math.min(1, (tick() - t0) / dur)
                p = 1 - (1 - p) * (1 - p)  -- quad out, same feel as the tweens
                o.BackgroundTransparency = baseO + (1 - baseO) * p
                for i, g in ipairs(bgs) do g.BackgroundTransparency = baseB[i] + (1 - baseB[i]) * p end
                for i, g in ipairs(texts) do g.TextTransparency = baseT[i] + (1 - baseT[i]) * p end
                for i, g in ipairs(strokes) do g.Transparency = baseS[i] + (1 - baseS[i]) * p end
                if p >= 1 then
                    conn:Disconnect()
                    o:Destroy()
                end
            end)
        end

        tween(overlay, { BackgroundTransparency = 0.6 }, 0.2)
        return setmetatable(dialog, DialogMeta)
    end

    -- ══════════════════════════════════════════════════════════════════
    -- GROUPBOX (section) — Obsidian-style: icon + title row, divider line,
    -- content below with padding. Auto-sizing: the box always fits its
    -- content (custom frames parented to .Container included), so nothing
    -- is ever clipped or overlapping.
    -- ══════════════════════════════════════════════════════════════════
    local GroupboxMeta = {}
    GroupboxMeta.__index = GroupboxMeta

    -- icon size tuning: read once from the caller's global so a build can
    -- pick a size, then live-resizable via PongiUI:SetGroupboxIconSize().
    -- Only the ICON IMAGE resizes; the header row stays a fixed 34px.
    local GROUPBOX_ICON_SIZE = tonumber(_G and _G.PONGI_GROUPBOX_ICON_SIZE) or 25
    local registeredGroupboxIcons = {}

    GroupboxFactory = function(parent, name, icon)
        local gb = Instance.new('Frame')
        -- side space comes from the scroll frame's UIPadding (the layout
        -- overrides child X positions, so insetting here would not hold)
        gb.Size = UDim2.new(1, 0, 0, 0)
        gb.AutomaticSize = Enum.AutomaticSize.Y
        gb.BackgroundColor3 = theme.bg
        gb.BorderSizePixel = 0
        corner(gb, 8)
        stroke(gb, theme.outline, 1)
        gb.Parent = parent
        local gbList = Instance.new('UIListLayout')
        gbList.SortOrder = Enum.SortOrder.LayoutOrder
        gbList.Parent = gb

        -- title row: icon + title + divider line. The HEAD stays a fixed
        -- 34px; only the icon IMAGE size is tunable (bigger icons sit
        -- centered and may overflow the row — fine while finding the size).
        local isize = GROUPBOX_ICON_SIZE
        local headH = 34
        local head = Instance.new('Frame')
        head.Size = UDim2.new(1, 0, 0, headH)
        head.BackgroundTransparency = 1
        head.Parent = gb
        if icon then
            local ic = makeIcon(icon, isize)
