        item._frame.Size = UDim2.new(1, 0, 0, 56)
        -- fake placeholder: the hint is always visible in gray until the
        -- user actually types (Roblox hides real placeholders on focus).
        -- TextButton/TextBox have no Padding in this client, so a two-space
        -- margin is baked into the text (stripped before the callback).
        local hint = info.Placeholder or ''
        local margin = '  '
        local realText = ''
        local function refresh()
            if realText == '' then
                box.Text = margin .. hint
                box.TextColor3 = theme.dim
            else
                box.Text = margin .. realText
                box.TextColor3 = Color3.new(1, 1, 1)
            end
        end
        refresh()
        box.Focused:Connect(function()
            if realText == '' then
                box.Text = margin
                box.TextColor3 = theme.font
            end
        end)
        box.FocusLost:Connect(function(enter)
            local stripped = box.Text:gsub('^%s+', '')
            realText = stripped
            refresh()
            if info.Callback then
                info.Callback(stripped, enter)
            end
        end)
        item._box = box
        return item
    end

    function GroupboxMeta:AddDropdown(id, info)
        _maybeYield()
        local gb = self
        -- 2px top/bottom margin like the buttons (label 2..18, display 20..52)
        local item = baseItem(gb, 54)
        local lbl = newFont(12)
        lbl.Size = UDim2.new(1, 0, 0, 16)
