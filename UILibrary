    -- TweenService:Create needs Plugin capability — elevate like the
    -- rest of the script does for its own UI work
    local function tween(inst, props, dur, style)
        local old = setthreadidentity and getthreadidentity() or 8
        if setthreadidentity then setthreadidentity(8) end
        pcall(function()
            TweenService:Create(inst, TweenInfo.new(dur or 0.2,
                style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
        end)
        if setthreadidentity then setthreadidentity(old) end
    end

    local function corner(inst, r)
        local c = Instance.new('UICorner')
        c.CornerRadius = UDim.new(0, r or theme.radius)
        c.Parent = inst
        return c
    end

    local function stroke(inst, color, thick)
        local s = Instance.new('UIStroke')
        s.Color = color or theme.outline
        s.Thickness = thick or 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = inst
        return s
    end

    local function newFont(size, bold)
        local l = Instance.new('TextLabel')
        l.Font = Enum.Font.Gotham
        l.TextSize = size or 14
        l.TextColor3 = theme.font
        l.BackgroundTransparency = 1
        l.BorderSizePixel = 0
        if bold then l.Font = Enum.Font.GothamBold end
        return l
    end

