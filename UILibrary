    -- GROUPBOX (section) — Obsidian-style: icon + title row, divider line,
    -- content below with padding. Auto-sizing: the box always fits its
    -- content (custom frames parented to .Container included), so nothing
    -- is ever clipped or overlapping.
    -- ══════════════════════════════════════════════════════════════════
    local GroupboxMeta = {}
    GroupboxMeta.__index = GroupboxMeta

    GroupboxFactory = function(parent, name, icon)
        local gb = Instance.new('Frame')
        -- side space comes from the scroll frame's UIPadding (the layout
        -- overrides child X positions, so insetting here would not hold)
        gb.Size = UDim2.new(1, 0, 0, 0)
        gb.AutomaticSize = Enum.AutomaticSize.Y
        gb.BackgroundColor3 = theme.bg
        gb.BorderSizePixel = 0
        corner(gb, 8)
        stroke(gb, theme.outline, 1)
        gb.Parent = parent
        local gbList = Instance.new('UIListLayout')
        gbList.SortOrder = Enum.SortOrder.LayoutOrder
        gbList.Parent = gb

        -- title row: icon + title + divider line (34px, like Obsidian)
        local head = Instance.new('Frame')
        head.Size = UDim2.new(1, 0, 0, 34)
        head.BackgroundTransparency = 1
        head.Parent = gb
        if icon then
            local ic = makeIcon(icon, 22)
            ic.Position = UDim2.fromOffset(10, 6)
            ic.Parent = head
        end
        local title = newFont(15)
        title.Size = UDim2.new(1, -36, 0, 22)
        title.Position = UDim2.fromOffset(icon and 46 or 12, 6)
        title.Text = name or 'Groupbox'
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = head
        local line = Instance.new('Frame')
        line.Size = UDim2.new(1, -16, 0, 1)
        line.Position = UDim2.new(0, 8, 1, -1)
        line.BackgroundColor3 = theme.outline
        line.BorderSizePixel = 0
        line.Parent = head

        -- content container: padded (7px all around, 8px gaps) and auto-sized
        local container = Instance.new('Frame')
        container.Size = UDim2.new(1, 0, 0, 0)
        container.AutomaticSize = Enum.AutomaticSize.Y
        container.BackgroundTransparency = 1
        container.Parent = gb
        local clist = Instance.new('UIListLayout')
        clist.Padding = UDim.new(0, 8)
        clist.SortOrder = Enum.SortOrder.LayoutOrder
        clist.Parent = container
        local cpad = Instance.new('UIPadding')
        cpad.PaddingLeft = UDim.new(0, 7)
        cpad.PaddingRight = UDim.new(0, 7)
        cpad.PaddingTop = UDim.new(0, 7)
        cpad.PaddingBottom = UDim.new(0, 7)
        cpad.Parent = container

        local groupbox = {
            _gb = gb,
            _head = head,
            _title = title,
            _container = container,
            _list = clist,
            _items = {},
            _parent = parent,
        }
        groupbox.Container = container
        return setmetatable(groupbox, GroupboxMeta)
    end

    -- auto-sizing makes manual resizing unnecessary; kept so existing call
    -- sites (gbStatus:Resize() after parenting custom frames) stay safe
    function GroupboxMeta:Resize()
        pcall(function()
            -- force a re-layout tick so AbsoluteContentSize settles
            self._container.Size = self._container.Size
        end)
    end

    local function baseItem(groupbox, height)
        local f = Instance.new('Frame')
        f.Size = UDim2.new(1, 0, 0, height)
